"""The module extension that fetches a prebuilt NVC.

A consumer gets a repository, `@nvc_prebuilt`, holding the binary this
project released and the standard libraries that binary compiled, with
an NVC toolchain for rules_nvc already declared over them.
"""

load(":versions.bzl", "DEFAULT_NVC_VERSION", "NVC_BINARIES")

_BUILD = '''\
# Generated by bazel_toolchains_nvc. Do not edit.
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_nvc//build/nvc:rules.bzl", "nvc_toolchain")

package(default_visibility = ["//visibility:public"])

# rules_nvc wants an executable from a rule, not a source file. The copy
# keeps a `bin/` parent, as rules_nvc expects of the binary's directory.
native_binary(
    name = "nvc",
    src = "bin/nvc",
    out = "prebuilt/bin/nvc",
)

# The standard libraries (std, ieee, nvc and the rest), compiled by this
# same binary: NVC reads only libraries its own version compiled. The
# directory is the label, as rules_nvc passes it to NVC with `-L`.
filegroup(
    name = "std",
    srcs = ["lib/nvc"],
)

nvc_toolchain(
    name = "toolchain_impl",
    analyzer = ":nvc",
    artifacts_dir = ":std",
)

toolchain(
    name = "toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":toolchain_impl",
    toolchain_type = "@rules_nvc//build/nvc:toolchain_type",
)
'''

def _prebuilt_impl(rctx):
    rctx.download_and_extract(
        url = rctx.attr.url,
        sha256 = rctx.attr.sha256,
        stripPrefix = rctx.attr.strip_prefix,
    )
    rctx.file("BUILD.bazel", _BUILD)

_prebuilt = repository_rule(
    implementation = _prebuilt_impl,
    attrs = {
        "url": attr.string(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
    },
    doc = "An NVC binary this project published, and its standard libraries.",
)

_use = tag_class(attrs = {
    "version": attr.string(
        doc = "Which published NVC to fetch.",
        default = DEFAULT_NVC_VERSION,
    ),
})

# One platform is published today. A second becomes another key in
# `versions.bzl`; the lookup below is already written for it.
_PLATFORM = "linux_x86_64"

def _impl(module_ctx):
    version = DEFAULT_NVC_VERSION
    for mod in module_ctx.modules:
        for use in mod.tags.use:
            version = use.version

    entry = NVC_BINARIES.get(version)
    if entry == None:
        fail(
            "bazel_toolchains_nvc has no binary for NVC {}. ".format(version) +
            "It has: {}.".format(", ".join(sorted(NVC_BINARIES))),
        )
    binary = entry.get(_PLATFORM)
    if binary == None:
        fail(
            "bazel_toolchains_nvc has no {} binary for NVC {}. ".format(_PLATFORM, version) +
            "It has: {}.".format(", ".join(sorted(entry))),
        )

    _prebuilt(
        name = "nvc_prebuilt",
        url = binary.url,
        sha256 = binary.sha256,
        strip_prefix = "nvc-{}-{}".format(version, _PLATFORM.replace("_", "-", 1)),
    )

nvc_binary = module_extension(
    implementation = _impl,
    tag_classes = {"use": _use},
    doc = "Fetches an NVC binary this repository published.",
)
